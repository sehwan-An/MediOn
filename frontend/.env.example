# =====================================================================
#  MediON 프론트엔드 설정 파일
#
#  사용법
#   1) 이 파일을 복사해서 .env 를 만든다:  copy .env.example .env
#   2) .env 에서 "✏️ 직접 입력" 표시가 있는 줄만 채운다
#
#  주의: VITE_ 로 시작하는 값은 브라우저에 그대로 노출돼요.
#        비밀번호나 비밀 키는 절대 여기에 넣지 마세요.
# =====================================================================


# ---------------------------------------------------------------------
# 1. 백엔드 주소                                            [그대로 두기]
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api


# ---------------------------------------------------------------------
# 2. 카카오맵 키                          [8단계 - 약국 지도 만들 때]
# ---------------------------------------------------------------------
# ✏️ 직접 입력: 카카오 개발자 콘솔의 "JavaScript 키"
#    콘솔에서 허용 도메인(http://localhost:5173)도 꼭 등록하세요
VITE_KAKAO_MAP_KEY=


# ---------------------------------------------------------------------
# 3. 토스페이먼츠 결제                        [7단계 - 결제 만들 때]
# ---------------------------------------------------------------------
# ✏️ 직접 입력: 토스페이먼츠 개발자센터 > API 키 > "테스트 클라이언트 키"
#    test_ck_ 로 시작해요. 시크릿 키(test_sk_)는 여기가 아니라 backend/.env 에 넣기
VITE_TOSS_CLIENT_KEY=

# 결제 방식. 비워두면 데모 결제(결제하기를 누르면 바로 완료, 토스 키 불필요)
# toss 로 쓰면 토스 테스트 결제창을 엶 (위 클라이언트 키 + backend TOSS_SECRET_KEY 필요)
VITE_PAYMENT_MODE=
