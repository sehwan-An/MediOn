# =====================================================================
#  MediON 백엔드 설정 파일
#
#  사용법
#   1) 이 파일을 복사해서 .env 를 만든다:  copy .env.example .env
#   2) .env 에서 "✏️ 직접 입력" 표시가 있는 줄만 채운다
#   3) = 앞뒤에 띄어쓰기를 넣지 않는다   (O) DB_PORT=3306   (X) DB_PORT = 3306
#
#  .env 에는 비밀번호가 들어가서 GitHub 에 올라가지 않게 설정돼 있어요.
# =====================================================================


# ---------------------------------------------------------------------
# 1. DB 접속 정보                                          [지금 필수]
#    HeidiSQL 에서 MariaDB 에 접속할 때 쓰는 정보와 똑같이 적으면 돼요.
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root

# ✏️ 직접 입력: HeidiSQL 접속 비밀번호 (특수문자가 있어도 그대로 적으면 돼요)
DB_PASSWORD=

DB_NAME=medion


# ---------------------------------------------------------------------
# 2. 로그인 보안 키                                         [지금 필수]
# ---------------------------------------------------------------------
# ✏️ 직접 입력: 아래 명령어를 터미널에서 실행해서 나온 긴 문자열을 붙여넣기
#    python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 로그인 유지 시간 (시간 단위) - 그대로 두기
JWT_EXPIRE_HOURS=12


# ---------------------------------------------------------------------
# 3. 프론트엔드 주소                                        [그대로 두기]
#    백엔드에 요청을 보낼 수 있는 화면 주소. 여러 개면 쉼표로 구분
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173


# ---------------------------------------------------------------------
# 4. 토스페이먼츠 결제                        [7단계 - 결제 만들 때]
#    토스페이먼츠 개발자센터 > API 키 > "테스트 시크릿 키"
#    서버에서만 쓰는 비밀 키예요. 프론트 .env 에 넣지 마세요.
#    test_sk_ 로 시작하는 테스트 키만 넣기 (live_sk_ 실제 키 금지)
# ---------------------------------------------------------------------
# ✏️ 직접 입력
TOSS_SECRET_KEY=


# ---------------------------------------------------------------------
# 5. 공공데이터포털 인증키                    [8단계 - 약국 찾기 만들 때]
#    공공데이터포털 > 마이페이지 > 개발계정 > "일반 인증키(Decoding)"
#    약국 정보(8단계)와 병원 정보(2차)에 같은 키를 써요
# ---------------------------------------------------------------------
# ✏️ 직접 입력
DATA_GO_KR_SERVICE_KEY=


# ---------------------------------------------------------------------
# 6. 파일 업로드                                [나중에 - 사진 첨부 만들 때]
#    local = 내 컴퓨터 backend/uploads 폴더에 저장 (개발할 땐 이대로)
# ---------------------------------------------------------------------
UPLOAD_BACKEND=local
CLOUDINARY_URL=


# ---------------------------------------------------------------------
# 7. 배포용 DB 주소                                   [지금은 비워두기]
#    배포 서버(Render)에서만 사용. 값을 넣으면 1번 DB_* 대신 이 주소를 써요
#    예) mysql+pymysql://사용자:비밀번호@호스트:포트/medion?charset=utf8mb4
# ---------------------------------------------------------------------
DATABASE_URL=
